# Copy to .env for npm run dev with your own MongoDB or Docker Compose.
# npm run dev:local automatically creates a local persistent replica set.
NODE_ENV=development
PORT=4000
# Keep 0 for direct local access; Compose sets 1 for its single Nginx proxy.
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/velora?replicaSet=rs0&directConnection=true
# Generate your own: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# A temporary random signing key is used in development if this is omitted.
# JWT_SECRET=replace-with-your-own-random-secret-at-least-32-characters
ENABLE_MOCK_PAYMENTS=true
RESERVATION_MINUTES=20
# Optional test mode only. No Stripe credentials are needed for mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local binary download launcher port (npm run dev:local only).
LOCAL_MONGO_PORT=27018
